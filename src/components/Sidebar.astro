---
import Mark from './Mark.astro';
import { siteConfig } from '../config';

const path = Astro.url.pathname;
const isSpanish = path === '/es/' || path.startsWith('/es/');

interface Props {
  language?: 'en' | 'es';
  languageHref?: string;
}

const {
  language = isSpanish ? 'es' : 'en',
  languageHref = language === 'es' ? '/' : '/es/',
} = Astro.props;

const links = language === 'es'
  ? [
      { href: '/es/', label: 'Inicio' },
      { href: '/es/articulos/', label: 'Artículos' },
      { href: '/es/#sobre-mi', label: 'Sobre mí' },
    ]
  : [
      { href: '/', label: 'Home' },
      { href: '/articles/', label: 'Articles' },
      { href: '/#about', label: 'About' },
    ];

const rssHref = language === 'es' ? '/es/rss.xml' : '/rss.xml';
---

<header class="sidebar">
  <div class="sidebar-inner">
    <Mark />
    <details class="site-menu">
      <summary>{language === 'es' ? 'Menú' : 'Menu'}</summary>
      <div class="sidebar-panel">
        <nav aria-label={language === 'es' ? 'Navegación principal' : 'Primary navigation'}>
          {links.map((link) => (
            <a
              href={link.href}
              class:list={{ active: link.href === '/' ? path === '/' : path.startsWith(link.href) }}
            >
              {link.label}
            </a>
          ))}
          <a href={rssHref}>RSS</a>
          <a class="language-switch" href={languageHref} hreflang={language === 'es' ? 'en' : 'es'}>
            {language === 'es' ? 'English' : 'Español'}
          </a>
        </nav>
        <div class="sidebar-socials" aria-label={language === 'es' ? 'Perfiles sociales' : 'Social profiles'}>
          {siteConfig.socialLinks.map((link) => (
            <a href={link.href} target="_blank" rel="noreferrer">
              {link.label} <span aria-hidden="true">↗</span>
            </a>
          ))}
        </div>
      </div>
    </details>
  </div>
</header>

<script>
  const menu = document.querySelector<HTMLDetailsElement>('.site-menu');
  const wideScreen = window.matchMedia('(min-width: 80rem)');

  if (menu) {
    const summary = menu.querySelector('summary');
    menu.open = wideScreen.matches;
    wideScreen.addEventListener('change', (event) => {
      if (!event.matches && menu.contains(document.activeElement)) summary?.focus();
      menu.open = event.matches;
    });
    menu.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape' || !menu.open) return;
      menu.open = false;
      summary?.focus();
    });
    menu.addEventListener('click', (event) => {
      if (!wideScreen.matches && event.target instanceof Element && event.target.closest('a')) {
        menu.open = false;
        summary?.focus({ preventScroll: true });
      }
    });
  }
</script>
