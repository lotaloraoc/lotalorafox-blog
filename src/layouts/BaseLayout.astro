---
import Sidebar from '../components/Sidebar.astro';
import { siteConfig } from '../config';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  article?: boolean;
  language?: 'en' | 'es';
  languageHref?: string;
}

const {
  title = siteConfig.name,
  description = siteConfig.description,
  image = '/social-card.svg',
  article = false,
  language = 'en',
  languageHref = language === 'es' ? '/' : '/es/',
} = Astro.props;

const pageTitle = title === siteConfig.name ? title : `${title} | ${siteConfig.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? siteConfig.siteUrl);
const socialImage = new URL(image, Astro.site ?? siteConfig.siteUrl);
---

<!doctype html>
<html lang={language}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={siteConfig.name}
      href={language === 'es' ? '/es/rss.xml' : '/rss.xml'}
    />
    <link rel="alternate" hreflang={language === 'es' ? 'en' : 'es'} href={new URL(languageHref, Astro.site ?? siteConfig.siteUrl)} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <div class="site-grid" aria-hidden="true"></div>
    <Sidebar language={language} languageHref={languageHref} />
    <main>
      <slot />
    </main>

    <script>
      async function renderMermaidDiagrams() {
        const blocks = document.querySelectorAll('pre[data-language="mermaid"] > code');
        if (!blocks.length) return;

        const { default: mermaid } = await import('mermaid');

        mermaid.initialize({
          startOnLoad: false,
          theme: 'base',
          securityLevel: 'strict',
          fontFamily: 'Arial, sans-serif',
          themeVariables: {
            background: '#f6f8fb',
            primaryColor: '#e5ebf5',
            primaryTextColor: '#111827',
            primaryBorderColor: '#7d8da8',
            lineColor: '#315b9a',
            secondaryColor: '#f6f8fb',
            tertiaryColor: '#ffffff',
          },
        });

        blocks.forEach((block, index) => {
          const pre = block.parentElement;
          if (!pre) return;

          const diagram = document.createElement('div');
          diagram.className = 'mermaid';
          diagram.id = `mermaid-${index}`;
          diagram.textContent = block.textContent ?? '';
          pre.replaceWith(diagram);
        });

        await mermaid.run({ querySelector: '.mermaid' });
      }

      renderMermaidDiagrams();
    </script>
  </body>
</html>
